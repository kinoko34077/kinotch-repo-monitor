{
  "schema_version": 1,
  "project": {
    "name": "kinotch-repo-monitor",
    "type": "windows-gui",
    "description": "Local Git repository activity monitor with ChatGPT chat jump links."
  },
  "profile": "windows-gui",
  "profiles": [
    "windows-gui"
  ],
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": true,
    "gui_windows": true,
    "web": false,
    "api": false,
    "mcp": false,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": "_run_python.cmd -m pip install -e .",
    "dev": "run.cmd",
    "test": "_run_python.cmd -m unittest discover -s tests -v",
    "build": "_run_python.cmd -m compileall -q src tests",
    "verify": "verify.cmd",
    "smoke": "run.cmd --smoke",
    "deploy": ""
  },
  "paths": {
    "docs": "docs/",
    "source": "src/",
    "tests": "tests/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "Structured for KiNoTch. Repository Base windows-gui profile.",
    "Runtime display order is derived only from locally registered/discovered repositories; devflow remains development-control authority and is not embedded into runtime state."
  ]
}
