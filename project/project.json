{
  "schema_version": 1,
  "project": {
    "name": "kinotch-repo-monitor",
    "type": "local-web",
    "description": "Localhost Web UI for monitoring local Git repository activity and jumping back to ChatGPT chats."
  },
  "profile": "local-web",
  "profiles": [
    "local-web"
  ],
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": true,
    "gui_windows": false,
    "web": true,
    "api": true,
    "mcp": false,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": "_run_python.cmd -m pip install -e .",
    "dev": "run.cmd",
    "test": "_run_python.cmd -m unittest discover -s tests -v",
    "build": "_run_python.cmd -m compileall -q src tests tools",
    "verify": "verify.cmd",
    "smoke": "run.cmd --smoke",
    "deploy": ""
  },
  "paths": {
    "docs": "docs/",
    "source": "src/",
    "tests": "tests/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "Uses a loopback-only local HTTP server and responsive Vanilla HTML/CSS/JS UI.",
    "Runtime display state is derived only from local Git/filesystem observation; devflow remains development-control authority."
  ]
}
